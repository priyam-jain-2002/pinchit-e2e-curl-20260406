{
  "name": "pinchit-e2e-curl",
  "version": "1.0.0",
  "description": "Minimal Node.js app with health-check script and tests",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "health-check": "node scripts/healthCheck.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "axios": "^1.6.7"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "scripts/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  }
}
